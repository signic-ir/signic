    "patch": "Index: frontend/src/layouts/default.vue\n===================================================================\n--- frontend/src/layouts/default.vue\t\n+++ frontend/src/layouts/default.vue\t\n@@ -0,0 +1,16 @@\n+<template>\n+  <div>\n+    <nav class=\"bg-white shadow-sm p-4\">\n+      <div class=\"max-w-6xl mx-auto flex justify-between items-center\">\n+        <h1 class=\"text-xl font-bold text-blue-600\">🎯 مارکت‌فلو</h1>\n+        <div class=\"space-x-4 flex items-center\">\n+          <NuxtLink to=\"/\" class=\"text-gray-600 hover:text-blue-600\">خانه</NuxtLink>\n+          <NuxtLink to=\"/watches\" class=\"text-gray-600 hover:text-blue-600\">پیگیری‌ها</NuxtLink>\n+        </div>\n+      </div>\n+    </nav>\n+    <main>\n+      <slot />\n+    </main>\n+  </div>\n+</template>\n",
