  {
    "file": "frontend/src/pages/watches.vue",
    "patch": "Index: frontend/src/pages/watches.vue\n===================================================================\n--- frontend/src/pages/watches.vue\t\n+++ frontend/src/pages/watches.vue\t\n@@ -0,0 +1,440 @@\n+<template>\n+  <div class=\"watches-page\" dir=\"rtl\">\n+    <!-- Header -->\n+    <div class=\"flex justify-between items-center mb-6\">\n+      <h1 class=\"text-2xl font-bold text-gray-800\">پیگیری محصولات</h1>\n+      <button @click=\"showAddForm = !showAddForm\" class=\"bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 flex items-center gap-2\">\n+        <span>➕</span> افزودن محصول جدید\n+      </button>\n+      <button @click=\"demoLogin()\" class=\"bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 flex items-center gap-2\">\n+        <span>👤</span> ورود به demo\n+      </button>\n+    </div>\n+\n+    <!-- Add Product Form -->\n+    <div v-if=\"showAddForm\" class=\"bg-white rounded-xl shadow p-6 mb-6\">\n+      <h2 class=\"text-lg font-bold mb-4\">افزودن محصول ترب به پیگیری</h2>\n+      <form @submit.prevent=\"addWatch\" class=\"space-y-4\">\n+        <!-- Product URL -->\n+        <div>\n+          <label class=\"block text-sm font-medium text-gray-700 mb-1\">لینک محصول ترب</label>\n+          <input\n+            v-model=\"newWatch.product_url\"\n+            type=\"url\"\n+            placeholder=\"https://torob.com/p/0099da4f-09a0-4255-b6e0-74e7ee8d5f1a/...\"\n+            class=\"w-full p-3 border border-gray-300 rounded-lg text-right focus:outline-none focus:border-blue-500\"\n+            dir=\"ltr\"\n+            required\n+          />\n+          <p class=\"text-xs text-gray-500 mt-1\">لینک کامل صفحه محصول از torob.com</p>\n+        </div>\n+\n+        <!-- Workflow Type -->\n+        <div>\n+          <label class=\"block text-sm font-medium text-gray-700 mb-1\">نوع هشدار</label>\n+          <select v-model=\"newWatch.workflow_type\" class=\"w-full p-3 border border-gray-300 rounded-lg text-right focus:outline-none focus:border-blue-500\">\n+            <option value=\"PRICE_RANGE_ALERT\">هشدار نطاق قیمت</option>\n+            <option value=\"PRICE_BELOW_ALERT\">هشدار کاهش قیمت</option>\n+            <option value=\"PRICE_ABOVE_ALERT\">هشدار افزایش قیمت</option>\n+          </select>\n+        </div>\n+\n+        <!-- Conditions -->\n+        <div>\n+          <label class=\"block text-sm font-medium text-gray-700 mb-1\">شرایط (JSON)</label>\n+          <textarea\n+            v-model=\"newWatch.conditions_str\"\n+            placeholder='{\"minimum_price\": 85000000, \"maximum_price\": 90000000}'\n+            class=\"w-full p-3 border border-gray-300 rounded-lg text-right font-mono text-sm focus:outline-none focus:border-blue-500\"\n+            rows=\"3\"\n+          />\n+          <p class=\"text-xs text-gray-500 mt-1\">حداقل/حداکثر قیمت (تومان)</p>\n+        </div>\n+\n+        <!-- Frequency -->\n+        <div>\n+          <label class=\"block text-sm font-medium text-gray-700 mb-1\">فرکانس بررسی (دقیقه)</label>\n+          <select v-model=\"newWatch.frequency_minutes\" class=\"w-full p-3 border border-gray-300 rounded-lg text-right focus:outline-none focus:border-blue-500\">\n+            <option :value=\"60\">هر ساعت</option>\n+            <option :value=\"360\">هر ۶ ساعت</option>\n+            <option :value=\"1440\">هر روز</option>\n+          </select>\n+        </div>\n+\n+        <!-- Error -->\n+        <div v-if=\"formError\" class=\"bg-red-50 text-red-700 p-3 rounded text-sm\">\n+          {{ formError }}\n+        </div>\n+\n+        <!-- Actions -->\n+        <div class=\"flex gap-3\">\n+          <button type=\"submit\" :disabled=\"submitting\" class=\"bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 disabled:opacity-50\">\n+            <span v-if=\"submitting\">در حال ثبت...</span>\n+            <span v-else>ثبت پیگیری</span>\n+          </button>\n+          <button type=\"button\" @click=\"showAddForm = false; resetForm()\" class=\"bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300\">\n+            انصراف\n+          </button>\n+        </div>\n+      </form>\n+    </div>\n+\n+    <!-- Loading -->\n+    <div v-if=\"loading\" class=\"text-center py-12 text-gray-500\">\n+      در حال بارگذاری...\n+    </div>\n+\n+    <!-- Watches List -->\n+    <div v-if=\"!loading\" class=\"space-y-4\">\n+      <div v-if=\"watches.length === 0\" class=\"bg-white rounded-xl shadow p-8 text-center text-gray-500\">\n+        <div class=\"text-4xl mb-3\">📦</div>\n+        <p>هنوز محصولی پیگیری نشده</p>\n+        <p class=\"text-sm mt-1\">لینک محصول ترب را اضافه کنید تا قیمت را پیگیری کنید</p>\n+      </div>\n+\n+      <div v-for=\"watch in watches\" :key=\"watch.id\" class=\"bg-white rounded-xl shadow p-6\">\n+        <div class=\"flex justify-between items-start\">\n+          <div class=\"flex-1\">\n+            <h3 class=\"font-bold text-lg text-gray-800\">{{ watch.product?.title || 'محصول ناشناس' }}</h3>\n+            <p class=\"text-sm text-gray-500 mt-1 break-all\">{{ watch.product_url }}</p>\n+            <div class=\"flex gap-3 mt-2 flex-wrap\">\n+              <span class=\"px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs\">ترب</span>\n+              <span class=\"px-2 py-1 bg-green-100 text-green-800 rounded text-xs\">\n+                {{ watch.workflow_type }}\n+              </span>\n+              <span class=\"px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs\">\n+                هر {{ watch.frequency_minutes }} دقیقه\n+              </span>\n+            </div>\n+          </div>\n+          <div class=\"flex gap-2\">\n+            <button @click=\"forceCheck(watch)\" class=\"px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200\">بررسی فوری</button>\n+            <button @click=\"toggleWatch(watch)\" class=\"px-3 py-1 bg-gray-100 text-gray-700 rounded text-sm hover:bg-gray-200\">\n+              {{ watch.is_active ? 'مکث' : 'فعال' }}\n+            </button>\n+          </div>\n+        </div>\n+\n+        <!-- Latest Observation -->\n+        <div v-if=\"watch.latest_observation\" class=\"mt-4 p-3 bg-gray-50 rounded-lg\">\n+          <div class=\"flex justify-between items-center\">\n+            <div>\n+              <span class=\"text-sm text-gray-600\">آخرین قیمت:</span>\n+              <span class=\"font-bold text-lg text-green-600 mr-2\">\n+                {{ formatNumber(watch.latest_observation?.normalized_data?.price?.amount || 0) }} تومان\n+              </span>\n+            </div>\n+            <div class=\"text-sm text-gray-500\">\n+              {{ watch.latest_observation.observed_at }}\n+            </div>\n+          </div>\n+          <div v-if=\"watch.latest_observation?.normalized_data\" class=\"mt-2 text-xs text-gray-500\">\n+            <span v-if=\"watch.latest_observation.normalized_data.seller_name\">فروشنده: {{ watch.latest_observation.normalized_data.seller_name }}</span>\n+            <span v-if=\"watch.latest_observation.normalized_data.availability\"> | وضعیت: {{ watch.latest_observation.normalized_data.availability }}</span>\n+          </div>\n+        </div>\n+\n+        <!-- Price History Link -->\n+        <div class=\"mt-3 flex gap-3\">\n+          <button @click=\"toggleHistory(watch.id)\" class=\"text-sm text-blue-600 hover:underline\">\n+            {{ showHistories[watch.id] ? 'مخفی تاریخچه' : 'مشاهده تاریخچه قیمت' }}\n+          </button>\n+        </div>\n+\n+        <!-- Price History -->\n+        <div v-if=\"showHistories[watch.id]\" class=\"mt-3 border-t pt-4\">\n+          <div v-if=\"watch.observations_loading\" class=\"text-sm text-gray-500\">در حال بارگذاری...</div>\n+          <div v-else-if=\"watch.history && watch.history.length === 0\" class=\"text-sm text-gray-500\">تاریخچه‌ای ثبت نشده</div>\n+          <div v-else-if=\"watch.history\" class=\"space-y-2\">\n+            <div v-for=\"obs in watch.history\" :key=\"obs.id\" class=\"flex justify-between items-center py-2 border-b text-sm\">\n+              <div class=\"flex items-center gap-2\">\n+                <span class=\"font-bold\" :class=\"(obs.normalized_data?.price?.amount || 0) >= (watch.history[watch.history.indexOf(obs)-1]?.normalized_data?.price?.amount || obs.normalized_data?.price?.amount) ? 'text-green-600' : 'text-red-600'\">\n+                  {{ formatNumber(obs.normalized_data?.price?.amount || 0) }} تومان\n+                </span>\n+                <span v-if=\"obs.normalized_data?.seller_name\" class=\"text-xs text-gray-500\">({{ obs.normalized_data.seller_name }})</span>\n+              </div>\n+              <span class=\"text-gray-500 text-xs\">{{ obs.observed_at }}</span>\n+            </div>\n+          </div>\n+          <button @click=\"loadHistory(watch)\" class=\"mt-2 text-sm text-blue-600 hover:underline\" :disabled=\"watch.observations_loading\">\n+            بارگذاری تاریخچه‌تر\n+          </button>\n+        </div>\n+      </div>\n+    </div>\n+  </div>\n+</template>\n+\n+<script setup lang=\"ts\">\n+import { ref, reactive, onMounted } from 'vue'\n+import { useAuthStore } from '~/stores/auth'\n+\n+const authStore = useAuthStore()\n+const loading = ref(true)\n+const showAddForm = ref(false)\n+const submitting = ref(false)\n+const formError = ref('')\n+const showHistories = reactive<Record<number, boolean>>({})\n+\n+// Demo user credentials\n+const DEMO_USER = {\n+  mobile: '+989991234567',\n+  password: 'demo12345',\n+} as const\n+\n+interface Observation {\n+  id: number\n+  observed_at: string\n+  normalized_data?: {\n+    price?: {\n+      amount?: number\n+      currency?: string\n+      display?: string\n+    }\n+    seller_name?: string\n+    availability?: string\n+    title?: string\n+  }\n+  raw_data?: any\n+  status?: string\n+}\n+\n+interface Watch {\n+  id: number\n+  product_url: string\n+  workflow_type: string\n+  frequency_minutes: number\n+  is_active: boolean\n+  last_checked_at: string | null\n+  latest_observation: Observation | null\n+  observations_loading?: boolean\n+  history?: Observation[]\n+  history_page?: number\n+  product?: {\n+    title: string\n+  } | null\n+}\n+\n+const watches = ref<Watch[]>([])\n+\n+const newWatch = reactive({\n+  product_url: '',\n+  workflow_type: 'PRICE_BELOW_ALERT',\n+  conditions_str: '{\"minimum_price\": 0}',\n+  frequency_minutes: 1440,\n+})\n+\n+async function demoLogin() {\n+  if (authStore.isAuthenticated) return\n+  \n+  loading.value = true\n+  try {\n+    await authStore.login(DEMO_USER)\n+    await fetchWatches()\n+  } catch (err: any) {\n+    formError.value = err.data?.message || 'خطا در ورود به حساب کاربری دمو'\n+  } finally {\n+    loading.value = false\n+  }\n+}\n+\n+async function fetchWatches() {\n+  loading.value = true\n+  try {\n+    const token = localStorage.getItem('auth_token')\n+    if (!token) {\n+      return\n+    }\n+    const resp = await $fetch('/watches', {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      headers: { Authorization: `Bearer ${token}` },\n+    })\n+    watches.value = (resp.data || []).map((w: Watch) => ({\n+      ...w,\n+      latest_observation: (w.observations?.[0] as Observation | null) || null,\n+      history: [],\n+      history_page: 1,\n+      observations_loading: false,\n+    }))\n+  } catch (err: any) {\n+    console.error('Failed to fetch watches:', err)\n+  } finally {\n+    loading.value = false\n+  }\n+}\n+\n+function resetForm() {\n+  newWatch.product_url = ''\n+  newWatch.workflow_type = 'PRICE_BELOW_ALERT'\n+  newWatch.conditions_str = '{\"minimum_price\": 0}'\n+  newWatch.frequency_minutes = 1440\n+  formError.value = ''\n+}\n+\n+function resetForm() {\n+  newWatch.product_url = ''\n+  newWatch.workflow_type = 'PRICE_BELOW_ALERT'\n+  newWatch.conditions_str = '{\"minimum_price\": 0}'\n+  newWatch.frequency_minutes = 1440\n+  formError.value = ''\n+}\n+\n+async function fetchWatches() {\n+  loading.value = true\n+  try {\n+    const token = localStorage.getItem('auth_token')\n+    if (!token) {\n+      await navigateTo('/login')\n+      return\n+    }\n+    const resp = await $fetch('/watches', {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      headers: { Authorization: `Bearer ${token}` },\n+    })\n+    watches.value = (resp.data || []).map((w: Watch) => ({\n+      ...w,\n+      latest_observation: (w.observations?.[0] as Observation | null) || null,\n+      history: [],\n+      history_page: 1,\n+      observations_loading: false,\n+    }))\n+  } catch (err: any) {\n+    console.error('Failed to fetch watches:', err)\n+  } finally {\n+    loading.value = false\n+  }\n+}\n+\n+async function addWatch() {\n+  formError.value = ''\n+  let conditions = {}\n+  try {\n+    conditions = JSON.parse(newWatch.conditions_str)\n+  } catch {\n+    formError.value = 'شرایط JSON نامعتبر است'\n+    return\n+  }\n+\n+  submitting.value = true\n+  try {\n+    const token = localStorage.getItem('auth_token')\n+    const resp = await $fetch('/watches', {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      method: 'POST',\n+      headers: {\n+        'Authorization': `Bearer ${token}`,\n+        'Content-Type': 'application/json',\n+      },\n+      body: {\n+        product_url: newWatch.product_url,\n+        workflow_type: newWatch.workflow_type,\n+        conditions,\n+        frequency_minutes: newWatch.frequency_minutes,\n+      },\n+    })\n+    showAddForm.value = false\n+    resetForm()\n+    await fetchWatches()\n+  } catch (err: any) {\n+    const msg = err?.data?.message || err?.data?.errors?.[0]?.[0] || 'خطا در ثبت پیگیری'\n+    formError.value = Array.isArray(msg) ? msg[0] : msg\n+  } finally {\n+    submitting.value = false\n+  }\n+}\n+\n+async function forceCheck(watch: Watch) {\n+  const token = localStorage.getItem('auth_token')\n+  try {\n+    await $fetch(`/admin/watches/${watch.id}/check`, {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      method: 'POST',\n+      headers: { Authorization: `Bearer ${token}` },\n+    })\n+    // Refresh observations\n+    await loadObservations(watch)\n+  } catch (err: any) {\n+    console.error('Force check failed:', err)\n+  }\n+}\n+\n+async function toggleWatch(watch: Watch) {\n+  const token = localStorage.getItem('auth_token')\n+  try {\n+    await $fetch(`/watches/${watch.id}`, {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      method: 'PUT',\n+      headers: {\n+        'Authorization': `Bearer ${token}`,\n+        'Content-Type': 'application/json',\n+      },\n+      body: { is_active: !watch.is_active },\n+    })\n+    watch.is_active = !watch.is_active\n+  } catch (err: any) {\n+    console.error('Toggle failed:', err)\n+  }\n+}\n+\n+async function loadObservations(watch: Watch) {\n+  const token = localStorage.getItem('auth_token')\n+  try {\n+    const resp = await $fetch(`/watches/${watch.id}/observations`, {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      headers: { Authorization: `Bearer ${token}` },\n+    })\n+    watch.latest_observation = resp.data?.[0] || null\n+  } catch {\n+    // silently fail\n+  }\n+}\n+\n+async function loadHistory(watch: Watch) {\n+  if (!watch.history) watch.history = []\n+  watch.observations_loading = true\n+  try {\n+    const token = localStorage.getItem('auth_token')\n+    const page = watch.history_page || 1\n+    const resp = await $fetch(`/watches/${watch.id}/observations`, {\n+      baseURL: useRuntimeConfig().public.apiBase,\n+      headers: { Authorization: `Bearer ${token}` },\n+      query: { per_page: 10, page },\n+    })\n+    const items = resp.data || []\n+    watch.history = [...watch.history, ...items]\n+    watch.history_page = page + 1\n+    if (items.length === 0) {\n+      // no more\n+    }\n+  } catch {\n+    // silently fail\n+  } finally {\n+    watch.observations_loading = false\n+  }\n+}\n+\n+function toggleHistory(watchId: number) {\n+  showHistories[watchId] = !showHistories[watchId]\n+  if (showHistories[watchId]) {\n+    const watch = watches.value.find(w => w.id === watchId)\n+    if (watch && (!watch.history || watch.history.length === 0)) {\n+      loadHistory(watch)\n+    }\n+  }\n+}\n+\n+function formatNumber(num: number): string {\n+  return num.toLocaleString('fa-IR')\n+}\n+\n+onMounted(() => {\n+    demoLogin()\n+  })\n+</script>\n+\n+<style scoped>\n+.watches-page {\n+  max-width: 900px;\n+  margin: 0 auto;\n+}\n+</style>\n\\ No newline at end of file\n",
    "additions": 440,
    "deletions": 0,
    "status": "added"
  }
]