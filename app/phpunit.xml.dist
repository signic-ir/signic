<?xml version="1.0" encoding="UTF-8"?>
<!--
    Copy this file to `phpunit.xml` before running the test suite:

        cp phpunit.xml.dist phpunit.xml

    `phpunit.xml` is git-ignored so that local overrides stay local.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnEmptyTestSuite="true"
         cacheDirectory=".phpunit.cache">
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:SGVsbG8gV29ybGQhIFRoaXMgaXMgYSBzZWNyZXQga2V5IQ=="/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="SMS_PROVIDER" value="null"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="REDIS_DATABASE" value="0"/>
        <env name="REDIS_CACHE_DB" value="1"/>
    </php>

    <testsuites>
        <testsuite name="Module Tests">
            <directory suffix="Test.php">./app/Modules</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">app/Modules</directory>
        </include>
    </source>
</phpunit>
