    "file": "docker-compose.yml",
    "patch": "Index: docker-compose.yml\n===================================================================\n--- docker-compose.yml\t\n+++ docker-compose.yml\t\n@@ -1,82 +1,84 @@\n version: '3.8'\n \n services:\n   backend:\n     build: ./backend\n     container_name: marketflow_backend\n     ports:\n       - \"8001:8000\"\n       - \"9000:9000\"\n     volumes:\n       - ./backend:/var/www/html\n     environment:\n       - DB_HOST=db\n       - DB_PORT=5432\n       - DB_NAME=marketplace\n       - DB_USER=postgres\n       - DB_PASSWORD=postgres\n       - REDIS_HOST=redis\n       - REDIS_PORT=6379\n       - PUSHER_APP_ID=${PUSHER_APP_ID}\n       - PUSHER_APP_KEY=${PUSHER_APP_KEY}\n       - PUSHER_APP_SECRET=${PUSHER_APP_SECRET}\n     depends_on:\n       - db\n       - redis\n     networks:\n       - sail\n       - default\n   \n   frontend:\n     build: ./frontend\n     container_name: marketflow_frontend\n     ports:\n       - \"3002:3000\"\n+    environment:\n+      - NUXT_PUBLIC_API_BASE=http://localhost:8001/api\n     networks:\n       - sail\n       - default\n   \n #  pgadmin4:\n #    image: dpage/pgadmin4\n #    container_name: pgadmin\n #    ports:\n #      - \"5050:80\"\n #    volumes:\n #      - pgadmin_data:/var/lib/pgadmin\n #    environment:\n #      - PGADMIN_DEFAULT_EMAIL=admin@marketflow\n #      - PGADMIN_DEFAULT_PASSWORD=admin\n #  \n   redis:\n     image: redis:latest\n     container_name: marketflow_redis\n     ports:\n       - \"6380:6379\"\n     volumes:\n       - redis_data:/data\n     networks:\n       - sail\n       - default\n \n   db:\n     image: postgres:15\n     container_name: marketflow_db\n     ports:\n       - \"5433:5432\"\n     volumes:\n       - postgres_data:/var/lib/postgresql/data\n     environment:\n       - POSTGRES_USER=postgres\n       - POSTGRES_PASSWORD=postgres\n       - POSTGRES_DB=marketplace\n     networks:\n       - sail\n       - default\n \n volumes:\n   postgres_data:\n   redis_data:\n \n networks:\n   sail:\n     external: true\n",
